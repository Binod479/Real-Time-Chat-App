PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_pern_chat_2026_xyz!@#$
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Managed PostgreSQL URL (e.g. Neon, Supabase, Render, Aiven)
# DATABASE_URL=postgresql://username:password@ep-host.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapp_db

# Local PostgreSQL parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
