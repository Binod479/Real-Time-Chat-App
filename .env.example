# ==============================================================
# PERN Real-Time Chat Application - Environment Configuration
# ==============================================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret Key (generate a strong random string in production)
JWT_SECRET=super_secret_jwt_key_pern_chat_2026_xyz!@#$
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and Socket.IO origin checks)
CLIENT_URL=http://localhost:5173

# ==============================================================
# PostgreSQL Database Connection
# ==============================================================
# Option 1: Managed PostgreSQL (Recommended: Neon.tech, Supabase, Render, Railway, ElephantSQL)
# Example: postgres://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapp_db

# Option 2: Individual Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
