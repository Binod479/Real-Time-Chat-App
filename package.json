{
  "name": "real-time-chat-pern",
  "version": "1.0.0",
  "description": "Production-ready Real-Time Chat Application built with PERN stack (PostgreSQL, Express, React, Node.js) and Socket.IO",
  "main": "server/src/index.js",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed",
    "start": "npm --prefix server start",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "pern",
    "real-time",
    "chat",
    "socket.io",
    "react",
    "material-ui",
    "postgresql",
    "express"
  ],
  "author": "Binod Yadav",
  "license": "MIT"
}